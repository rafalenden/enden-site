---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Breadcrumb } from '@/types';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const pageTitle = 'Amp for Bandcamp';
const description =
  'Enhance Bandcamp with volume control, auto-play, BPM detection, keyboard shortcuts and playback progress. Available for Safari, Chrome and Firefox.';

const breadcrumbs: Breadcrumb[] = [
  {
    title: 'Projects',
    href: '/projects',
  },
];
---

<BaseLayout title={pageTitle} description={description}>
  <main class="narrow-page">
    <div class="narrow-content">
      <Breadcrumbs breadcrumbs={breadcrumbs} />

      <h1>{pageTitle}</h1>

      <div class="links">
        <a href="https://apps.apple.com/app/amp-for-bandcamp/id6745343456">
          Add to Safari
        </a>
        <a
          href="https://chromewebstore.google.com/detail/amp-for-bandcamp/gjmlgkbcolbleloakpcfhfaodldlheld"
        >
          Add to Chrome
        </a>
        <a
          href="https://addons.mozilla.org/en-US/firefox/addon/amp-for-bandcamp/"
        >
          Add to Firefox
        </a>
        <a href="https://github.com/rafalenden/amp-for-bandcamp">
          Source Code
        </a>
        <a href="/projects/amp-for-bandcamp/privacy-policy"> Privacy Policy </a>
      </div>

      <a
        class="screenshot-link"
        href="/projects/amp-for-bandcamp/screenshot-1-dark.png"
        onclick="this.href = this.querySelector('img').currentSrc"
        target="_blank"
        rel="noopener"
      >
        <picture>
          <source
            srcset="/projects/amp-for-bandcamp/screenshot-1-dark.png"
            media="(prefers-color-scheme: dark)"
          />
          <img
            class="screenshot"
            src="/projects/amp-for-bandcamp/screenshot-1-light.png"
            alt="Amp for Bandcamp showing live BPM detection, automatic track playback, a feed progress bar, volume and seek settings, and keyboard shortcuts."
            width="2880"
            height="1800"
          />
        </picture>
      </a>

      <p>
        Amp for Bandcamp adds volume control, automatic track playback, BPM
        detection and keyboard shortcuts to Bandcamp. Available for Safari,
        Chrome and Firefox.
      </p>

      <h2>Key Features</h2>

      <p>
        <strong>BPM Detection</strong> — See the tempo of the playing track on album
        pages, measured in beats per minute.
      </p>

      <p>
        <strong>Volume Control & Seeking</strong> — Use the extension popup to set
        the playback volume and the number of seconds to skip with seek shortcuts.
      </p>

      <p>
        <strong>Auto-Play Next Track</strong> — Keep listening as Amp advances to
        the next track when the current one finishes.
      </p>

      <p>
        <strong>Keyboard Shortcuts</strong> — Control playback and manage tracks from
        your keyboard:
      </p>
      <div>
        <kbd>space</kbd> Play/Pause
      </div>
      <div>
        <kbd>↑</kbd> Previous Track
      </div>
      <div>
        <kbd>↓</kbd> Next Track
      </div>
      <div>
        <kbd>→</kbd> Seek Forward
      </div>
      <div>
        <kbd>←</kbd> Seek Backward
      </div>
      <div>
        <kbd>w</kbd> Add Track to Wishlist
      </div>
      <div>
        <kbd>enter</kbd> Open Track in a New Tab
      </div>

      <p>
        <strong>Sticky Album Player</strong> — Pin the player to the top of album
        pages so playback controls stay visible while you scroll.
      </p>

      <p>
        <strong>Leave-Page Warning</strong> — Enable an optional warning before leaving
        Bandcamp while music is playing.
      </p>

      <p>
        <strong>Privacy & Permissions:</strong> This extension only works on Bandcamp.com
        and requires minimal permissions. No personal data is collected or transmitted.
        All settings are stored locally on your device.
      </p>

      <p>
        <strong>Important Note:</strong> This extension is not affiliated with Bandcamp.
        It's an independent project designed to enhance your Bandcamp experience while
        respecting the original platform.
      </p>

      <p>
        Many thanks to{' '}
        <a href="https://instagram.com/silarskimusic/">Grzegorz Silarski</a>{
          ' '
        }
        for ideas and testing.
      </p>
    </div>
  </main>
</BaseLayout>

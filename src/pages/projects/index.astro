---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NarrowPage from '@/components/NarrowPage.astro';

const pageTitle = 'Projects';
---

<BaseLayout title={pageTitle}>
  <NarrowPage pageTitle={pageTitle}>
    <h2>
      <a href="/projects/temponome">Temponome</a>
    </h2>
    <p>
      A lightweight macOS menu bar app that detects the tempo of system audio in
      beats per minute (BPM).
    </p>
    <h2>
      <a href="/projects/amp-for-bandcamp">Amp for Bandcamp</a>
    </h2>
    <p>
      Enhance Bandcamp with volume control, auto-play, BPM detection, keyboard
      shortcuts and playback progress.
    </p>
  </NarrowPage>
</BaseLayout>
